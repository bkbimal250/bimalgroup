# GEMINI_API_KEY: Optional in this template; AI Studio injects at runtime if configured.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Canonical production URL where this application is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="https://bimalglobal.com"

# GOOGLE_APPS_SCRIPT_URL: HTTPS Web App URL of your deployed Google Apps Script.
# Server-side only — never prefix with VITE_ or expose to browser code.
GOOGLE_APPS_SCRIPT_URL=

# GOOGLE_APPS_SCRIPT_SECRET: High-entropy shared secret verified by Code.gs doPost().
# Server-side only — must match ENQUIRY_SHARED_SECRET in Apps Script Script Properties.
GOOGLE_APPS_SCRIPT_SECRET=

# GOOGLE_SITE_VERIFICATION: Optional Google Search Console verification token.
GOOGLE_SITE_VERIFICATION=
